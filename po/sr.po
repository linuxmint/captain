#: data/captain.desktop.in:2
msgid "Package Installer"
msgstr "Инсталер пакета"

#: data/captain.desktop.in:3
msgid "Install a software package"
msgstr "Инсталирајте софтверски пакет"

#: usr/lib/captain/captain.py:136 usr/lib/captain/captain.py:455
msgid "Broken dependencies"
msgstr "Нарушене зависности"

#: usr/lib/captain/captain.py:136 usr/lib/captain/captain.py:329
#: usr/lib/captain/captain.py:455
msgid "To fix this run 'sudo apt-get install -f' in a terminal window."
msgstr ""
"Да поправите ово покрените „sudo apt-get install -f“ у прозору терминала."

#: usr/lib/captain/captain.py:159
#, python-format
msgid "%s is not a valid package"
msgstr "„%s“ није исправан пакет"

#: usr/lib/captain/captain.py:160
#, python-format
msgid "The MIME type of this file is '%s'."
msgstr "MIME врста ове датотеке је „%s“:"

#: usr/lib/captain/captain.py:162
#, python-format
msgid "Could not open %s"
msgstr "Не могу да отворим „%s“"

#: usr/lib/captain/captain.py:163
msgid "The file might be corrupted or missing permissions."
msgstr "Датотека је можда оштећена или недостају овлашћења."

#: usr/lib/captain/captain.py:179
msgid "Control files"
msgstr "Датотеке контроле"

#: usr/lib/captain/captain.py:183
msgid "Data files"
msgstr "Датотеке података"

#: usr/lib/captain/captain.py:190
msgid "Error while reading the content"
msgstr "Грешка приликом читања садржаја"

#: usr/lib/captain/captain.py:195 usr/lib/captain/captain.py:220
#: usr/lib/captain/captain.py:227 usr/lib/captain/captain.py:237
#: usr/share/captain/deb_package.ui:402
msgid "_Install Package"
msgstr "_Инсталирај пакет"

#: usr/lib/captain/captain.py:220
#, python-format
msgid "Error: %s"
msgstr "Грешка: %s"

#: usr/lib/captain/captain.py:226
#, python-format
msgid "Error: No longer provides %s"
msgstr "Грешка: Више не обезбеђује „%s“"

#: usr/lib/captain/captain.py:236
#, python-format
msgid "Requires changes in %d other package"
msgid_plural "Requires changes in %d other packages"
msgstr[0] "Захтева измене у још %d другом пакету"
msgstr[1] "Захтева измене у још %d друга пакета"
msgstr[2] "Захтева измене у још %d других пакета"

#: usr/lib/captain/captain.py:254
msgid "KB"
msgstr "KB"

#: usr/lib/captain/captain.py:254
msgid "MB"
msgstr "MB"

#: usr/lib/captain/captain.py:254 usr/lib/captain/captain.py:255
msgid "GB"
msgstr "GB"

#: usr/lib/captain/captain.py:295
msgid "The same version is already installed"
msgstr "Исто издање је већ инсталирано"

#: usr/lib/captain/captain.py:295
msgid "_Reinstall Package"
msgstr "_Поново инсталирај пакет"

#: usr/lib/captain/captain.py:297
msgid "It is safer and recommended to install from the repositories instead."
msgstr "Безбедније је и препоручљивије да инсталирате из ризница."

#: usr/lib/captain/captain.py:298
msgid "This package is available in the repositories"
msgstr "Овај пакет је доступан у ризницама"

#: usr/lib/captain/captain.py:329
msgid "Failed to install all dependencies"
msgstr "Нисам успео да инсталирам све зависности"

#: usr/lib/captain/captain.py:334 usr/share/captain/deb_package.ui:587
#, python-format
msgid "%s is now installed."
msgstr "„%s“ је сада инсталиран."

#: usr/lib/captain/captain.py:362
msgid "The content could not be extracted"
msgstr "Садржај се не може распаковати"

#: usr/lib/captain/captain.py:479 usr/lib/captain/captain.py:482
#: usr/lib/captain/captain.py:484 usr/lib/captain/captain.py:542
#, python-format
msgid "The package '%s' could not be installed"
msgstr "Пакет „%s“ се не може инсталирати"

#: usr/lib/captain/captain.py:479
msgid "It was not found in the repositories."
msgstr "Нисам га нашао у ризницама."

#: usr/lib/captain/captain.py:482
msgid "It is already installed."
msgstr "Већ је инсталиран."

#: usr/lib/captain/captain.py:484
msgid "It is not installable."
msgstr "Не може се инсталирати."

#: usr/lib/captain/captain.py:503 usr/share/captain/apt_url.ui:50
#, python-format
msgid "Do you want to install '%s'?"
msgstr "Да ли желите да инсталирате „%s“?"

#: usr/share/captain/apt_url.ui:8
msgid "Install additional software?"
msgstr "Да инсталирам додатни софтвер?"

#: usr/share/captain/apt_url.ui:97
msgid "Description"
msgstr "Опис"

#: usr/share/captain/apt_url.ui:147
msgid "_Install"
msgstr "_Инсталирај"

#: usr/share/captain/deb_package.ui:8
msgid "Details"
msgstr "Појединости"

#: usr/share/captain/deb_package.ui:56
msgid "The following packages need to be installed:"
msgstr "Следећи пакети треба да се инсталирају:"

#: usr/share/captain/deb_package.ui:92
msgid "The following packages need to be removed:"
msgstr "Следећи пакети треба да се уклоне:"

#: usr/share/captain/deb_package.ui:175
msgid "Opening the package"
msgstr "Отварам пакет"

#: usr/share/captain/deb_package.ui:227
msgid "_Details"
msgstr "_Појединости"

#: usr/share/captain/deb_package.ui:316
msgid "Maintainer:"
msgstr "Одржавалац:"

#: usr/share/captain/deb_package.ui:358
msgid "Size:"
msgstr "Величина:"

#: usr/share/captain/deb_package.ui:383
msgid "Included files"
msgstr "Укључене датотеке"

#: usr/share/captain/deb_package.ui:571
msgid "The installation was successful"
msgstr "Инсталација је успела"
