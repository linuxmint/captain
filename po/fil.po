#: data/captain.desktop.in:2
msgid "Package Installer"
msgstr "Package Installer"

#: data/captain.desktop.in:3
msgid "Install a software package"
msgstr "Mag-install ng software package"

#: usr/lib/captain/captain.py:136 usr/lib/captain/captain.py:455
msgid "Broken dependencies"
msgstr "Broken dependencies"

#: usr/lib/captain/captain.py:136 usr/lib/captain/captain.py:329
#: usr/lib/captain/captain.py:455
msgid "To fix this run 'sudo apt-get install -f' in a terminal window."
msgstr ""
"Para ayusin ito, patakbuhin ang 'sudo apt-get install -f' sa Terminal."

